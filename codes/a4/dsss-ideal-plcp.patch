+/**
+ * A4 (Kong et al. 2004 reproduction): when the environment variable NS3_DSSS_IDEAL_PLCP is
+ * set, the 192-bit PLCP preamble + header is sent at the 11 Mb/s data rate (17.455 us)
+ * instead of at 1 Mb/s (192 us), as in the paper's Table I. Default behaviour is unchanged.
+ */
+bool
+IdealPlcp()
+{
+    static const bool ideal = std::getenv("NS3_DSSS_IDEAL_PLCP") != nullptr;
+    return ideal;
+}
